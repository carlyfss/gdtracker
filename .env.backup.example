# Environment variables for scripts/backup-to-r2.sh and scripts/test-r2-rclone.sh.
# Postgres runs in Docker on the Raspberry Pi; R2 is off-site backup storage via rclone.
# Scripts set rclone no_check_bucket=true for Object Read & Write tokens.
# Copy names only — store real values in Jenkins credentials / secret store, not in git.
#
# Required:
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=gdtracker-backup
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
#
# Optional:
# R2_PREFIX=gdtracker/pg
# RCLONE_REMOTE=r2
# R2_TEST_PREFIX=gdtracker/test
# POSTGRES_CONTAINER=gdtracker-postgres
# POSTGRES_USER=gdtracker
# POSTGRES_DB=gdtracker
# BACKUP_RETENTION_COUNT=8
# COMPOSE_DIR=/var/lib/jenkins/workspace/GDTracker   # deploy workspace on Pi (not backup job workspace)
