# Environment variables for scripts/backup-to-r2.sh (devserver.local or Jenkins on the Pi).
# Postgres runs in Docker on the Raspberry Pi; R2 is off-site backup storage via rclone.
# Copy names only — store real values in Jenkins credentials / secret store, not in git.
#
# Required:
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=gdtracker-backups
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
#
# Optional:
# R2_PREFIX=gdtracker/pg
# RCLONE_REMOTE=r2              # ephemeral remote name built from env (default: r2)
# POSTGRES_CONTAINER=gdtracker-postgres
# POSTGRES_USER=gdtracker
# POSTGRES_DB=gdtracker
# BACKUP_RETENTION_COUNT=8
# COMPOSE_DIR=/home/admin/gdtracker   # path to repo on devserver.local
