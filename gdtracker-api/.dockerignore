# Build output (the Dockerfile builds inside the image)
target/
*.jar
*.war

# Local Maven cache
.m2/

# Env files (real secrets must never be baked into the image)
.env
.env.*
!.env.example

# VCS / IDE / OS junk
.git
.gitignore
.gitattributes
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Docs / non-source noise
docs/
*.md
!README.md

# Node leftovers (just in case)
node_modules/
