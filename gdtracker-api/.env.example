# gdtracker-api environment variables.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# JDBC URL for the PostgreSQL database the API connects to.
# Examples:
#   jdbc:postgresql://localhost:5432/numb_tracker            (local Postgres on host)
#   jdbc:postgresql://postgres:5432/numb_tracker             (compose service "postgres")
#   jdbc:postgresql://<your-db-host>:5432/numb_tracker       (remote Postgres)
DB_URL=jdbc:postgresql://localhost:5432/numb_tracker

# Database role used by the API.
DB_USERNAME=numb_tracker

# Password for DB_USERNAME. No default in code; the app fails to start if unset.
DB_PASSWORD=

# HTTP port the Spring Boot server listens on.
SERVER_PORT=8080

# Comma-separated origin patterns allowed for credentialed /api/** requests (Docker / cross-origin SPA).
# http://localhost:PORT and http://127.0.0.1:PORT count as distinct — include both if you alternate hosts.
# Examples:
# GDTRACKER_CORS_ALLOWED_ORIGINS=http://localhost:3000
# GDTRACKER_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
