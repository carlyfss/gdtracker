# gdtracker-web (Vite/React) environment variables.
#
# Local dev: Vite loads VITE_* from the repository root `.env` (see vite.config.ts envDir).
# Copy the root `.env.example` to `.env` at the repo root and set Auth0 vars there.
#
# Override here only if you need web-only values without touching the root file.

# Where the dev server proxies /api/* during `npm run dev`.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Absolute API base URL for production builds. Leave empty in dev (proxy handles /api).
VITE_API_BASE_URL=

# Auth: session (default) | auth0
# VITE_AUTH_MODE=auth0
# VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=your-spa-client-id
# VITE_AUTH0_AUDIENCE=https://api.gdtracker.local
