# gdtracker (Vite/React) environment variables.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Where the dev server proxies /api/* during `npm run dev`.
# Use the URL of the running backend (default: local Spring Boot on :8080).
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Absolute API base URL used by *production* builds (`npm run build`, `npm run preview`,
# and the Docker image). Leave empty in dev — the dev server uses the proxy above.
# Example for compose: http://localhost:8080
# Example for a deployed backend: https://api.example.com
VITE_API_BASE_URL=
