[configuration]
entry_symbol = "gdtracker_library_init"
compatibility_minimum = "4.0"

[libraries]
linux.debug.x86_64 = "res://addons/gdtracker_native/bin/libgdtracker.linux.debug.x86_64.so"
linux.release.x86_64 = "res://addons/gdtracker_native/bin/libgdtracker.linux.release.x86_64.so"
windows.debug.x86_64 = "res://addons/gdtracker_native/bin/gdtracker.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://addons/gdtracker_native/bin/gdtracker.windows.release.x86_64.dll"
macos.debug = "res://addons/gdtracker_native/bin/libgdtracker.macos.debug.dylib"
macos.release = "res://addons/gtracker_native/bin/libgdtracker.macos.release.dylib"

