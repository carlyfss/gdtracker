# Copy to .env.deploy (gitignored). Never commit real hostnames.
DEPLOY_HOST=deploy-host.local
DEPLOY_SSH_USER=admin
GDTRACKER_PUBLIC_APP_HOST=app.example.com
GDTRACKER_PUBLIC_API_HOST=api.example.com
# Paste into Jenkins / root .env for prod:
# GDTRACKER_CORS_ALLOWED_ORIGINS=https://app.example.com
# VITE_API_BASE_URL=https://api.example.com
# AUTH0_AUDIENCE=https://api.example.com   # if your API identifier matches public API URL
