# Workspace-level env file consumed by docker-compose.yml.
# Copy to `.env` and fill in real values. `.env` is git-ignored.
#
# Raspberry Pi: prefer 64-bit OS and `docker compose build` on the device (correct arm64/arm).
# For low RAM boards, monitor Postgres; optional: tune shared_buffers outside this file.

# --- PostgreSQL container (postgres service) ---
POSTGRES_USER=gdtracker
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=gdtracker

# --- Backend (docker-compose `backend` = gdtracker-go-api) ---
# DB_URL must use the compose service hostname `postgres` so the API container
# can reach the DB on the compose network.
DB_URL=jdbc:postgresql://postgres:5432/gdtracker?sslmode=disable
DB_USERNAME=gdtracker
DB_PASSWORD=change-me-locally

# Published host port for the API; compose sets the Go container's PORT to this value.
SERVER_PORT=8080

# Required for gdtracker-go-api when DB_URL is set (session signing).
GDTRACKER_SESSION_SECRET=change-me-long-random-at-least-32-chars

# Browser origins allowed for session cookies (comma-separated). Docker Compose
# can derive this from FRONTEND_PORT when you omit it; override if the SPA URL differs.
# Origin must match the URL you open: http://localhost:4173 and http://127.0.0.1:4173
# count as different — list both if you switch between them, or stick to one host.
# GDTRACKER_CORS_ALLOWED_ORIGINS=http://localhost:4173

# Cookie domain for cross-subdomain SPA + API (often empty for localhost).
# GDTRACKER_COOKIE_DOMAIN=

# Secure cookies when the API is only served over HTTPS.
# GDTRACKER_COOKIE_SECURE=false

# golang-migrate on API startup: auto | on | off (see gdtracker-go-api/docs/MIGRATIONS.md).
# auto (default) / on — apply embedded migrations Up on startup. off — skip (manual migrate CLI if needed).
# GDTRACKER_GO_AUTO_MIGRATE=auto

# One-shot dirty repair (only when schema_migrations.dirty is true); then unset.
# GDTRACKER_GO_MIGRATE_FORCE_VERSION=18

# Archive retention (optional; see gdtracker-go-api/docs/ARCHIVE_RETENTION.md).
# GDTRACKER_ARCHIVE_RETENTION=false
# GDTRACKER_ARCHIVE_RETENTION_TIMEZONE=UTC
# GDTRACKER_ARCHIVE_RETENTION_HOUR=3
# GDTRACKER_ARCHIVE_RETENTION_MINUTE=17

# --- Host-only: gdtracker-go-api (go run on the host, not in Compose) ---
# Hostname `postgres` does not resolve outside Docker; use 127.0.0.1 and the
# published Postgres port from docker-compose.yml (default host mapping 5433:5432), e.g.:
# DB_URL=jdbc:postgresql://127.0.0.1:5433/gdtracker?sslmode=disable
# Listen port for `go run` (Compose uses SERVER_PORT above for the container).
# PORT=8080

# --- Frontend (gdtracker-web image / npm project) ---
# Baked into the Vite build at image build time. From the host's browser the
# backend is reachable at http://localhost:${SERVER_PORT}, so use that.
VITE_API_BASE_URL=http://localhost:8080

# Dev-only (gdtracker-web): Vite proxy target for `npm run dev` (/api -> backend).
# Not used by the frontend Docker build. Match SERVER_PORT / PORT on the host.
# Example if the API listens on 8000: http://localhost:8000
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Host port the frontend is published on. Default 4173 (matches Vite preview / built PWA).
FRONTEND_PORT=4173
