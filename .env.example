# Workspace-level env file consumed by docker-compose.yml.
# Copy to `.env` and fill in real values. `.env` is git-ignored.

# --- PostgreSQL container (postgres service) ---
POSTGRES_USER=gdtracker
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=gdtracker

# --- Backend (gdtracker-api service) ---
# DB_URL must use the compose service hostname `postgres` so the backend
# container can reach the DB on the compose network.

# --- gdtracker-go-api (run on host: go run ./gdtracker-go-api/cmd/gdtracker-go-api) ---
# Reuses DB_USERNAME / DB_PASSWORD above. Override DB_URL for the host: hostname `postgres`
# does not resolve outside Docker; use localhost and the published Postgres port from
# docker-compose.yml (default host mapping 5433:5432), e.g.:
# DB_URL=jdbc:postgresql://127.0.0.1:5433/gdtracker?sslmode=disable
DB_URL=jdbc:postgresql://postgres:5432/gdtracker?sslmode=disable
DB_USERNAME=gdtracker
DB_PASSWORD=change-me-locally
SERVER_PORT=8080

# Browser origins allowed for session cookies (comma-separated). Docker Compose
# sets this from FRONTEND_PORT when you omit it; override if the SPA URL differs.
# Origin must match the URL you open: http://localhost:5173 and http://127.0.0.1:5173
# count as different — list both if you switch between them, or stick to one host.
# Used by Spring Boot and by gdtracker-go-api (same semantics).
# GDTRACKER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cookie domain for cross-subdomain SPA + API (needed for CSRF token cookie readability).
# Example for https://subdomain.domain.com + https://api.domain.com:
# GDTRACKER_COOKIE_DOMAIN=.domain.com

# If DB_URL is set, Go requires a session signing secret (not used by Spring in this file):
# GDTRACKER_SESSION_SECRET=change-me-long-random-at-least-32-chars

# golang-migrate when the Go process starts: auto | on | off (see gdtracker-go-api/docs/MIGRATIONS.md).
# GDTRACKER_GO_AUTO_MIGRATE=auto

# One-shot dirty repair (only when schema_migrations.dirty is true); then unset.
# GDTRACKER_GO_MIGRATE_FORCE_VERSION=18

# HTTP listen port for the Go binary (Spring docker image uses SERVER_PORT instead).
# PORT=8080

# Secure cookies (set true when the API is served only over HTTPS).
# GDTRACKER_COOKIE_SECURE=false

# --- Frontend (gdtracker-web image / npm project) ---
# Baked into the Vite build at image build time. From the host's browser the
# backend is reachable at http://localhost:${SERVER_PORT}, so use that.
VITE_API_BASE_URL=http://localhost:8080
# Host port the frontend is published on. Default 5173 to match `npm run dev`.
FRONTEND_PORT=5173
