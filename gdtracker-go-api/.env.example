# Copy to .env and fill in (do not commit .env).
# Same variables as Spring gdtracker-api (application.properties).

# If omitted, sslmode=prefer is added so local Postgres without SSL works (override e.g. ?sslmode=require).
# From your machine (go run): use localhost and the published port. In repo root docker-compose.yml Postgres is 5433:5432, e.g. jdbc:postgresql://localhost:5433/gdtracker
# Hostname "postgres" only works inside the Docker network (containers), not on the host.
DB_URL=jdbc:postgresql://localhost:5432/numb_tracker
DB_USERNAME=numb_tracker
DB_PASSWORD=

# golang-migrate on startup: auto | on | off
# auto — skip embedded migrations when Liquibase table databasechangelog exists (shared DB with Spring).
# on — always run migrate up (greenfield / Go-only DB).
# off — never run migrate up from the binary (use migrate CLI or Liquibase only).
GDTRACKER_GO_AUTO_MIGRATE=auto

# Repair dirty migrations only: when schema_migrations.dirty is true, Force() this version once (e.g. 18), then unset. Ignored if not dirty. See docs/MIGRATIONS.md.
# GDTRACKER_GO_MIGRATE_FORCE_VERSION=18

# Required when DB_URL is set (gorilla/sessions + securecookie; derive keys from this string).
GDTRACKER_SESSION_SECRET=12334565678901234567890123456789

# Comma-separated origin patterns (same semantics as Spring gdtracker.cors.allowed-origins).
GDTRACKER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional cookie Domain for cross-subdomain deployments (matches Spring gdtracker.cookie-domain).
GDTRACKER_COOKIE_DOMAIN=localhost

# Set true behind HTTPS so JSESSIONID / XSRF-TOKEN are Secure cookies.
GDTRACKER_COOKIE_SECURE=false

PORT=8080

# Archive retention (Spring ArchiveRetentionService parity). Omit or set to anything except false/0/off/no to enable when DB_URL is set.
# GDTRACKER_ARCHIVE_RETENTION=false
# Default 03:17 in UTC (Spring used JVM default timezone; set explicitly in production).
# GDTRACKER_ARCHIVE_RETENTION_TIMEZONE=UTC
# GDTRACKER_ARCHIVE_RETENTION_HOUR=3
# GDTRACKER_ARCHIVE_RETENTION_MINUTE=17
