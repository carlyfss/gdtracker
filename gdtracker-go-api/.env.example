# Copy to .env and fill in (do not commit .env).
# Same variables as Spring gdtracker-api (application.properties).

DB_URL=jdbc:postgresql://localhost:5432/numb_tracker
DB_USERNAME=numb_tracker
DB_PASSWORD=

# golang-migrate on startup: auto | on | off
# auto — skip embedded migrations when Liquibase table databasechangelog exists (shared DB with Spring).
# on — always run migrate up (greenfield / Go-only DB).
# off — never run migrate up from the binary (use migrate CLI or Liquibase only).
GDTRACKER_GO_AUTO_MIGRATE=auto

PORT=8080
